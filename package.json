{
  "name": "@lumen-media/locales",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Lumen open-source translation files.",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "translate": "node --env-file-if-exists=.env scripts/translate.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "pnpm validate && biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
